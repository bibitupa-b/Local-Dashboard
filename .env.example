# DeepSeek API key from platform.deepseek.com. Without it the dashboard works, minus the briefing.
DEEPSEEK_API_KEY=
# Google Cloud OAuth client (type: Desktop app). Redirect URI: http://127.0.0.1:4317/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Path to the Obsidian vault. Defaults to %USERPROFILE%\Documents\Main Obsidian Vault
VAULT_PATH=
# Local port. Defaults to 4317
PORT=4317
# Hour of the daily briefing, 0-23. Defaults to 8
BRIEFING_HOUR=8
# Gmail IMAP account and app password (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# GitHub classic token with the notifications scope
GITHUB_TOKEN=
# Optional: path to a Chromium History file. Auto-detects Chrome then Edge when empty.
BROWSER_HISTORY_PATH=
