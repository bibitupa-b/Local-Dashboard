# All values are optional. Connections are managed in Settings.
# The file is imported once on first start and stays useful for CLI runs.

# Local port. Defaults to 4317
PORT=4317

# Fallback DeepSeek key. Prefer Settings -> Connections -> DeepSeek API.
DEEPSEEK_API_KEY=

# Fallback vault folder. Prefer adding vaults in Settings.
VAULT_PATH=

# Optional Google import (Desktop OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Gmail import (app password with 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional GitHub import (classic token with the notifications scope).
GITHUB_TOKEN=

# Optional browser import. Auto-detects Helium, Chrome and Edge when empty.
BROWSER_HISTORY_PATH=
