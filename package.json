{
  "name": "local-dashboard",
  "version": "1.16.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "description": "A single-user dashboard that runs on your own machine and shows one quiet screen: what changed in your notes and cloud drive, what is waiting for your attention, and a short daily briefing written by DeepSeek.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild src/server/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/server.cjs",
    "electron:dev": "npm run build && npm run build:server && electron .",
    "dist": "npm run build && npm run build:server && electron-builder --win",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "build": {
    "appId": "com.bibitupa.localdashboard",
    "productName": "Local Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/icon-tray.png",
      "assets/icon-transparent.png",
      "assets/icon-transparent-96.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Local-Dashboard-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Local-Dashboard-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bibitupa-b/Local-Dashboard.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/bibitupa-b/Local-Dashboard/issues"
  },
  "homepage": "https://github.com/bibitupa-b/Local-Dashboard#readme",
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "chokidar": "^6.0.0",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.7",
    "googleapis": "^189.0.0",
    "ical.js": "^2.2.1",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "node-cron": "^4.6.0",
    "node-notifier": "^12.0.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdav": "^2.5.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "bibitupa-b",
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
