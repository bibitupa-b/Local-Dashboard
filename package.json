{
  "name": "local-dashboard",
  "version": "1.0.0",
  "description": "A single-user dashboard that runs on your own machine and shows one quiet screen: what changed in your notes and cloud drive, what is waiting for your attention, and a short daily briefing written by DeepSeek.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bibitupa-b/Local-Dashboard.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/bibitupa-b/Local-Dashboard/issues"
  },
  "homepage": "https://github.com/bibitupa-b/Local-Dashboard#readme",
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "chokidar": "^6.0.0",
    "fastify": "^5.12.7",
    "googleapis": "^189.0.0",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
